<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox style="-fx-background-color: #f5f5f9;" styleClass="spacing30" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox VBox.vgrow="ALWAYS">
         <children>
            <VBox styleClass="card-header-nr">
               <children>
                  <HBox>
                     <styleClass>
                        <String fx:value="justify-content-center" />
                        <String fx:value="spacing30" />
                     </styleClass>
                     <children>
                        <TextField promptText="Search Category" styleClass="form-control" />
                        <HBox HBox.hgrow="ALWAYS" />
                        <ChoiceBox styleClass="form-select" />
                        <Button mnemonicParsing="false" text="Add Category">
                           <styleClass>
                              <String fx:value="btn" />
                              <String fx:value="btn-primary" />
                              <String fx:value="btn-padding" />
                           </styleClass>
                           <graphic>
                              <FontIcon iconLiteral="bx-plus" />
                           </graphic>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>
            <TableView styleClass="table" tableMenuButtonVisible="true" VBox.vgrow="ALWAYS">
              <columns>
                  <TableColumn prefWidth="34.0" />
                <TableColumn prefWidth="41.0">
                     <graphic>
                        <CheckBox mnemonicParsing="false" styleClass="form-check-input" />
                     </graphic>
                  </TableColumn>
                <TableColumn prefWidth="210.0" text="CATEGORIE" />
                  <TableColumn prefWidth="75.0" text="TOTAL PRODUCTS" />
                  <TableColumn prefWidth="75.0" text="TOTAL EARNING" />
                  <TableColumn prefWidth="75.0" text="QTY" />
                  <TableColumn prefWidth="75.0" text="ACTIONS" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox styleClass="card-footer">
               <children>
                  <VBox pickOnBounds="false" prefWidth="50.0" />
                  <Label text="Displaying 1 to 7 of 100 entries" />
                  <VBox HBox.hgrow="ALWAYS" />
                  <HBox styleClass="spacing5">
                     <children>
                        <Button mnemonicParsing="false" styleClass="page-item" text="Previous" />
                        <Button mnemonicParsing="false" styleClass="page-item" text="1" />
                        <Button mnemonicParsing="false" styleClass="page-item" text="2" />
                        <Button mnemonicParsing="false" styleClass="page-item" text="3" />
                        <Button mnemonicParsing="false" styleClass="page-item" text="4" />
                        <Button mnemonicParsing="false" styleClass="page-item" text="5" />
                        <Button mnemonicParsing="false" styleClass="page-item" text="6" />
                        <Button mnemonicParsing="false" styleClass="page-item" text="..." />
                        <Button mnemonicParsing="false" styleClass="page-item" text="Next" />
                        <VBox pickOnBounds="false" prefWidth="50.0" />
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
         <styleClass>
            <String fx:value="card" />
            <String fx:value="justify-content-top-left" />
         </styleClass>
      </VBox>
   </children>
</VBox>
