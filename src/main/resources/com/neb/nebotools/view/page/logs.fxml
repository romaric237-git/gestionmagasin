<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox prefHeight="610.0" prefWidth="937.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.neb.nebotools.controller.page.setting.SettingController">
   <children>
      <VBox styleClass="card-header">
         <children>
            <Label text="Filter">
               <styleClass>
                  <String fx:value="h5" />
                  <String fx:value="mb-2" />
               </styleClass>
            </Label>
         </children>
      </VBox>
      <VBox styleClass="card-header-nr">
         <children>
            <HBox>
               <styleClass>
                  <String fx:value="justify-content-center" />
                  <String fx:value="spacing30" />
               </styleClass>
               <children>
                  <TextField fx:id="search" promptText="Search Log" styleClass="form-control" />
                  <HBox HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnAdd" mnemonicParsing="false" text="Add Product" visible="false">
                     <styleClass>
                        <String fx:value="btn" />
                        <String fx:value="btn-primary" />
                        <String fx:value="btn-padding" />
                     </styleClass>
                     <graphic>
                        <FontIcon iconLiteral="bx-plus" />
                     </graphic>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
      <TableView fx:id="table" styleClass="table" tableMenuButtonVisible="true" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="columnLog" prefWidth="210.0" style="-fx-alignment: center;" text="%log.entity" />
            <TableColumn fx:id="columnEmploye" prefWidth="75.0" text="%employee.entity" />
            <TableColumn fx:id="columnLogin" prefWidth="75.0" text="%employee.login" />
            <TableColumn fx:id="columnType" prefWidth="75.0" text="TYPE" />
            <TableColumn fx:id="columnEntity" prefWidth="75.0" text="%log.entityName" />
            <TableColumn fx:id="columnEntityId" prefWidth="75.0" style="-fx-alignment: center_right;" text="%log.entityId" />
            <TableColumn fx:id="columnDate" prefWidth="75.0" text="DATE" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox fx:id="pagination" styleClass="card-footer">
         <children>
            <VBox pickOnBounds="false" prefWidth="50.0" />
            <Label fx:id="pagination_display" text="Displaying 1 to 7 of 100 entries" />
            <VBox HBox.hgrow="ALWAYS" />
            <HBox fx:id="index" styleClass="spacing5">
               <children>
                  <Button fx:id="pagination_prev" mnemonicParsing="false" styleClass="page-item" text="Previous" />
                  <Button mnemonicParsing="false" styleClass="page-item" text="1" />
                  <Button mnemonicParsing="false" styleClass="page-item" text="2" />
                  <Button mnemonicParsing="false" styleClass="page-item" text="3" />
                  <Button mnemonicParsing="false" styleClass="page-item" text="4" />
                  <Button mnemonicParsing="false" styleClass="page-item" text="5" />
                  <Button mnemonicParsing="false" styleClass="page-item" text="6" />
                  <Button mnemonicParsing="false" styleClass="page-item" text="..." />
                  <Button fx:id="pagination_next" mnemonicParsing="false" styleClass="page-item" text="Next" />
                  <VBox pickOnBounds="false" prefWidth="50.0" />
               </children>
            </HBox>
         </children>
      </HBox>
   </children>
   <styleClass>
      <String fx:value="card" />
      <String fx:value="justify-content-top-left" />
   </styleClass>
</VBox>
