<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.neb.nebotools.controller.page.customer.CustomerController">
   <children>
      <HBox styleClass="spacing20">
         <children>
            <VBox>
               <children>
                  <Label text="%customer.titleAdd">
                     <styleClass>
                        <String fx:value="h4" />
                        <String fx:value="mb-1" />
                        <String fx:value="bolder" />
                     </styleClass>
                  </Label>
                  <Label text="%customer.titleSubAdd">
                     <styleClass>
                        <String fx:value="h6" />
                        <String fx:value="text-muted" />
                     </styleClass>
                  </Label>
               </children>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" />
            <VBox />
            <Button fx:id="cancelBtn" mnemonicParsing="false" text="%btn.discard">
               <styleClass>
                  <String fx:value="btn" />
                  <String fx:value="btn-label-secondary" />
                  <String fx:value="btn-padding" />
               </styleClass>
            </Button>
            <Button fx:id="addBtn" mnemonicParsing="false" text="%customer.add">
               <styleClass>
                  <String fx:value="btn" />
                  <String fx:value="btn-primary" />
                  <String fx:value="btn-padding" />
               </styleClass>
            </Button>
         </children>
      </HBox>
      <HBox styleClass="spacing30">
         <children>
            <VBox styleClass="spacing30" HBox.hgrow="ALWAYS">
               <children>
                  <VBox>
                     <styleClass>
                        <String fx:value="card" />
                        <String fx:value="mb-2" />
                     </styleClass>
                     <children>
                        <VBox styleClass="card-body">
                           <children>
                              <Label text="%customer.part">
                                 <styleClass>
                                    <String fx:value="h5" />
                                    <String fx:value="bolder" />
                                    <String fx:value="mb-4" />
                                 </styleClass>
                              </Label>
                              <HBox>
                                 <children>
                                    <VBox HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="form-label" text="%customer.firstname" />
                                          <VBox>
                                             <children>
                                                <TextField fx:id="firstname" promptText="john" styleClass="form-control" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="form-label" text="%customer.lastname" />
                                          <VBox>
                                             <children>
                                                <TextField fx:id="lastname" promptText="Doe" styleClass="form-control" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </VBox>
                                 </children>
                                 <styleClass>
                                    <String fx:value="mb-3" />
                                    <String fx:value="spacing30" />
                                 </styleClass>
                              </HBox>
                              <HBox>
                                 <children>
                                    <VBox HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="form-label" text="%customer.mail" />
                                          <VBox>
                                             <children>
                                                <TextField fx:id="mail" promptText="john.Doe" styleClass="form-control" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="form-label" text="%customer.phone" />
                                          <VBox>
                                             <children>
                                                <TextField fx:id="phone" promptText="6 90 18 53 35" styleClass="form-control" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </VBox>
                                 </children>
                                 <styleClass>
                                    <String fx:value="mb-3" />
                                    <String fx:value="spacing30" />
                                 </styleClass>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
   <styleClass>
      <String fx:value="spacing30" />
      <String fx:value="justify-content-top-left" />
   </styleClass>
</VBox>
